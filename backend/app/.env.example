# CloudLearn AI Backend Environment Variables
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database URL (Neon Cloud PostgreSQL)
