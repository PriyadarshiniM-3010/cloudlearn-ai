DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
